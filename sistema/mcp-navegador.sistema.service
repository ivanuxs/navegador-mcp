[Unit]
Description=MCP de navegador (Playwright MCP + proxy con token)
Documentation=file:///home/oficina-2/Nextcloud/Proyectos/mcp/navegador/LEEME.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=oficina-2
Group=oficina-2
WorkingDirectory=/home/oficina-2/Nextcloud/Proyectos/mcp/navegador
Environment=HOME=/home/oficina-2
# Node está en ~/.local/node (instalado sin sudo); el resto, del sistema.
Environment=PATH=/home/oficina-2/.local/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/oficina-2/Nextcloud/Proyectos/mcp/navegador/arrancar.sh
# Chromium tarda en cerrarse; el trap del script mata al MCP.
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
